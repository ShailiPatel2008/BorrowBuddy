<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Location permissions -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Camera permission -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Camera is optional -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".BorrowBuddyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BorrowBuddy">

        <activity
            android:name=".activities.MyListingsActivity"
            android:exported="false" />

        <activity
            android:name=".activities.RentalHistoryActivity"
            android:exported="false" />

        <activity
            android:name=".activities.EarningsActivity"
            android:exported="false" />

        <activity
            android:name=".activities.BorrowerRatingActivity"
            android:exported="false" />

        <activity
            android:name=".activities.TermsActivity"
            android:exported="false" />

        <activity
            android:name=".activities.SettingsActivity"
            android:exported="false" />

        <activity
            android:name=".activities.OwnerProfileActivity"
            android:exported="false"/>

        <activity
            android:name=".activities.EditOwnerProfileActivity"
            android:exported="false"/>

        <activity
            android:name=".activities.ChangePasswordActivity"
            android:exported="false"/>

        <activity
            android:name=".activities.MyItemRequestsActivity"
            android:exported="false"/>

        <activity
            android:name=".activities.HelpSupportActivity"
            android:exported="false"/>

        <activity
            android:name=".activities.AddItemActivity"
            android:exported="false" />

        <activity
            android:name=".activities.RatingsReviewsActivity"
            android:exported="false" />

        <activity
            android:name=".activities.OwnerDashboardActivity"
            android:exported="false"/>

        <activity
            android:name=".LoginActivity"
            android:exported="false" />

        <activity
            android:name=".ForgotPasswordActivity"
            android:exported="false" />

        <activity
            android:name=".OTPActivity"
            android:exported="false" />

        <activity
            android:name=".RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ChooseRoleActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"/>

        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".CreateNewPasswordActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".UserHomeActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".AdminHomeActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".AdminLoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".AdminDashboardActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".MyProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".activity_admin_login"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".OwnerLoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>