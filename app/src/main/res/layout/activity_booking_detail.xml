<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA">

    <!-- ================= HEADER ================= -->

    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#6A1B9A"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/backButton"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="←"
            android:textColor="#FFFFFF"
            android:textSize="32sp" />

        <TextView
            android:id="@+id/headerTitle"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Booking Detail"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <View
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="#6A1B9A" />

    </LinearLayout>


    <!-- ================= CONTENT ================= -->

    <ScrollView
        android:id="@+id/bookingDetailScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#F5F7FA"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/bookingDetailMainLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">


            <!-- ================= ITEM IMAGE ================= -->

            <ImageView
                android:id="@+id/itemImage"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginBottom="15dp"
                android:contentDescription="Item Image"
                android:scaleType="centerCrop" />


            <!-- ================= ITEM NAME ================= -->

            <TextView
                android:id="@+id/itemName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:gravity="center"
                android:text="Item"
                android:textColor="#000000"
                android:textSize="24sp"
                android:textStyle="bold" />


            <!-- ================= BOOKING INFORMATION ================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/bookingInfoCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="12dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">


                    <!-- TITLE -->

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="15dp"
                        android:text="Booking Information"
                        android:textColor="#000000"
                        android:textSize="18sp"
                        android:textStyle="bold" />


                    <!-- PRICE -->

                    <TextView
                        android:id="@+id/priceText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="10dp"
                        android:text="Price: ₹0"
                        android:textColor="#333333"
                        android:textSize="16sp" />


                    <!-- DURATION -->

                    <TextView
                        android:id="@+id/durationText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="10dp"
                        android:text="Duration: 0 Days"
                        android:textColor="#333333"
                        android:textSize="16sp" />


                    <!-- START DATE -->

                    <TextView
                        android:id="@+id/startDateText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="10dp"
                        android:text="Start Date: Today"
                        android:textColor="#333333"
                        android:textSize="16sp" />


                    <!-- END DATE -->

                    <TextView
                        android:id="@+id/endDateText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="10dp"
                        android:text="End Date: After 0 Days"
                        android:textColor="#333333"
                        android:textSize="16sp" />


                    <!-- STATUS -->

                    <TextView
                        android:id="@+id/statusText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Status: Confirmed"
                        android:textColor="#2E7D32"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================= BOOKING ID ================= -->

            <TextView
                android:id="@+id/bookingIdText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:text="Booking ID: BB1025"
                android:textColor="#555555"
                android:textSize="16sp" />


            <!-- ================= OWNER DETAILS ================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/ownerDetailsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="25dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="12dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">


                    <!-- OWNER TITLE -->

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="Owner Details"
                        android:textColor="#000000"
                        android:textSize="18sp"
                        android:textStyle="bold" />


                    <!-- OWNER NAME -->

                    <TextView
                        android:id="@+id/ownerNameText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="8dp"
                        android:text="Owner: Unknown"
                        android:textColor="#333333"
                        android:textSize="16sp" />


                    <!-- OWNER CONTACT -->

                    <TextView
                        android:id="@+id/ownerContactText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Contact: Not Available"
                        android:textColor="#333333"
                        android:textSize="16sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================= CANCEL BUTTON ================= -->

            <Button
                android:id="@+id/cancelBookingButton"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:backgroundTint="#D32F2F"
                android:text="Cancel Booking"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>