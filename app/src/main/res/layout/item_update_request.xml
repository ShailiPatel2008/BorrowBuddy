<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_marginBottom="16dp"
    android:background="@drawable/update_request_card">

    <!-- ================= ITEM IMAGE ================= -->

    <TextView
        android:id="@+id/txtImagePlaceholder"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:gravity="center"
        android:text="📷"
        android:textSize="45sp"
        android:textColor="@color/text_secondary"
        android:background="@color/card_background"/>


    <!-- ================= ITEM NAME ================= -->

    <TextView
        android:id="@+id/txtItemName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="DSLR Camera"
        android:textColor="@color/text_primary"
        android:textSize="19sp"
        android:textStyle="bold"/>


    <!-- ================= OWNER ================= -->

    <TextView
        android:id="@+id/txtOwner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:text="Owner: Shaili Patel"
        android:textColor="@color/text_secondary"
        android:textSize="15sp"/>


    <!-- ================= CHANGES ================= -->

    <TextView
        android:id="@+id/txtChanges"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Changes: 4"
        android:textColor="@color/text_primary"
        android:textSize="15sp"/>


    <!-- ================= DATE ================= -->

    <TextView
        android:id="@+id/txtDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Date: 02 Sep 2026"
        android:textColor="@color/text_secondary"
        android:textSize="15sp"/>


    <!-- ================= VIEW REQUEST ================= -->

    <Button
        android:id="@+id/btnViewRequest"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="end"
        android:layout_marginTop="12dp"
        android:text="View Request"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:backgroundTint="@color/button_grey"/>

</LinearLayout>