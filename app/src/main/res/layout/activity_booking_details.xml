<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#101010">

    <!-- ================= TOOLBAR ================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#AB47BC">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="60dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="←"
            android:textColor="#FFFFFF"
            android:textSize="38sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/txtToolbarTitle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Booking Details"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"/>

        <View
            android:layout_width="20dp"
            android:layout_height="match_parent"/>

    </LinearLayout>


    <!-- ================= CONTENT ================= -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/contentLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="15dp">


            <!-- ================= IMAGE CARD ================= -->

            <LinearLayout
                android:id="@+id/imageCard"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:gravity="center"
                android:background="#232323"
                android:layout_marginBottom="15dp">

                <TextView
                    android:id="@+id/txtImagePlaceholder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📷"
                    android:textSize="50sp"/>

            </LinearLayout>


            <!-- ================= BOOKING INFORMATION ================= -->

            <LinearLayout
                android:id="@+id/bookingInfoCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp"
                android:background="#232323"
                android:layout_marginBottom="15dp">

                <TextView
                    android:id="@+id/titleBookingInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="BOOKING INFORMATION"
                    android:textColor="#FFFFFF"
                    android:textSize="23sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="15dp"/>

                <TextView
                    android:id="@+id/txtBookingId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Booking ID: BB001"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/txtBookingDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Booking Date: 18 Aug 2026"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/txtStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Status: Pending"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"/>

            </LinearLayout>


            <!-- ================= CUSTOMER INFORMATION ================= -->

            <LinearLayout
                android:id="@+id/customerCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp"
                android:background="#232323"
                android:layout_marginBottom="15dp">

                <TextView
                    android:id="@+id/titleCustomer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="CUSTOMER INFORMATION"
                    android:textColor="#FFFFFF"
                    android:textSize="23sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="15dp"/>

                <TextView
                    android:id="@+id/txtCustomerName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Customer Name: Rahul"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/txtCustomerPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Contact Number: 9876543210"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"/>

            </LinearLayout>


            <!-- ================= OWNER INFORMATION ================= -->

            <LinearLayout
                android:id="@+id/ownerCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp"
                android:background="#232323"
                android:layout_marginBottom="15dp">

                <TextView
                    android:id="@+id/titleOwner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="OWNER INFORMATION"
                    android:textColor="#FFFFFF"
                    android:textSize="23sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="15dp"/>

                <TextView
                    android:id="@+id/txtOwnerName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Owner Name: Priya"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/txtOwnerPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Contact Number: 9876543211"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"/>

            </LinearLayout>


            <!-- ================= TRUST & REVIEWS ================= -->

            <LinearLayout
                android:id="@+id/trustCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp"
                android:background="#232323"
                android:layout_marginBottom="15dp">

                <TextView
                    android:id="@+id/titleTrust"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="OWNER TRUST &amp; REVIEWS"
                    android:textColor="#FFFFFF"
                    android:textSize="23sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="15dp"/>

                <TextView
                    android:id="@+id/txtTrustScore"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Trust Score: 4.8 ⭐"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/txtReviews"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Reviews: 24 Reviews"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"/>

            </LinearLayout>


            <!-- ================= ITEM INFORMATION ================= -->

            <LinearLayout
                android:id="@+id/itemInfoCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp"
                android:background="#232323"
                android:layout_marginBottom="15dp">

                <TextView
                    android:id="@+id/titleItem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ITEM INFORMATION"
                    android:textColor="#FFFFFF"
                    android:textSize="23sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="15dp"/>

                <TextView
                    android:id="@+id/txtItemName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Item Name: Camera"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/txtCategory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Category: Electronics"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/txtCondition"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Condition: Good"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/txtQuantity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Quantity: 2"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"/>

            </LinearLayout>


            <!-- ================= RENTAL INFORMATION ================= -->

            <LinearLayout
                android:id="@+id/rentalCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp"
                android:background="#232323"
                android:layout_marginBottom="15dp">

                <TextView
                    android:id="@+id/titleRental"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="RENTAL INFORMATION"
                    android:textColor="#FFFFFF"
                    android:textSize="23sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="15dp"/>

                <TextView
                    android:id="@+id/txtStartDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Start Date: 20 Aug 2026"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/txtEndDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="End Date: 22 Aug 2026"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/txtPricePerDay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Price Per Day: ₹900"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/txtDeposit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Security Deposit: ₹1,000"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/txtTotalAmount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Total Amount: ₹1800"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

            </LinearLayout>


            <!-- ================= PICKUP INFORMATION ================= -->

            <LinearLayout
                android:id="@+id/pickupCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp"
                android:background="#232323"
                android:layout_marginBottom="15dp">

                <TextView
                    android:id="@+id/titlePickup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PICKUP INFORMATION"
                    android:textColor="#FFFFFF"
                    android:textSize="23sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="15dp"/>

                <TextView
                    android:id="@+id/txtPickup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pickup Location: Hazira, Surat"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"/>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>