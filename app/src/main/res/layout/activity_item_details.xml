<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/itemDetailsLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ================= TOOLBAR ================= -->

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#6A1B9A"
            android:title="Item Details"
            android:titleTextColor="@android:color/white"
            android:elevation="4dp"
            app:navigationIconTint="@android:color/white" />


        <!-- ================= IMAGE ================= -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/itemImageCard"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginStart="30dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="30dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="25dp"
            app:cardElevation="3dp">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/imageViewPager"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </com.google.android.material.card.MaterialCardView>


        <!-- ================= 5 DOTS ================= -->

        <LinearLayout
            android:id="@+id/dotsLayout"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/dot1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:text="●"
                android:textColor="#6A1B9A"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/dot2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:text="○"
                android:textColor="#777777"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/dot3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:text="○"
                android:textColor="#777777"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/dot4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:text="○"
                android:textColor="#777777"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/dot5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:text="○"
                android:textColor="#777777"
                android:textSize="14sp" />

        </LinearLayout>


        <!-- ================= DETAILS CARD ================= -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/detailsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="30dp"
            android:layout_marginBottom="30dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="25dp"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="25dp">

                <!-- ITEM NAME -->

                <TextView
                    android:id="@+id/itemName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Canon Camera"
                    android:textColor="#000000"
                    android:textSize="26sp"
                    android:textStyle="bold" />


                <!-- OWNER -->

                <TextView
                    android:id="@+id/itemOwner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Owner: Not Available"
                    android:textColor="#000000"
                    android:textSize="17sp" />


                <!-- CATEGORY -->

                <TextView
                    android:id="@+id/itemCategory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Category: Electronics"
                    android:textColor="#000000"
                    android:textSize="17sp" />


                <!-- PRICE -->

                <TextView
                    android:id="@+id/itemPrice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Price: ₹150/day"
                    android:textColor="#000000"
                    android:textSize="19sp"
                    android:textStyle="bold" />


                <!-- CITY -->

                <TextView
                    android:id="@+id/itemCity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Ahmedabad"
                    android:textColor="#000000"
                    android:textSize="17sp" />


                <!-- RATING -->

                <TextView
                    android:id="@+id/itemRating"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="★★★★☆"
                    android:textColor="#FFC107"
                    android:textSize="24sp" />


                <!-- DESCRIPTION TITLE -->

                <TextView
                    android:id="@+id/descriptionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:text="Description"
                    android:textColor="#000000"
                    android:textSize="20sp"
                    android:textStyle="bold" />


                <!-- DESCRIPTION -->

                <TextView
                    android:id="@+id/itemDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Good quality item available for borrowing. Please handle the item carefully and return it on time."
                    android:textColor="#000000"
                    android:textSize="16sp" />


                <!-- LOCATION TITLE -->

                <TextView
                    android:id="@+id/locationTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:text="Location"
                    android:textColor="#000000"
                    android:textSize="20sp"
                    android:textStyle="bold" />


                <!-- LOCATION -->

                <TextView
                    android:id="@+id/itemLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Ahmedabad, Gujarat"
                    android:textColor="#000000"
                    android:textSize="16sp" />


                <!-- REQUEST BUTTON -->

                <Button
                    android:id="@+id/btnRequestBorrow"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="18dp"
                    android:backgroundTint="#6A1B9A"
                    android:text="Request to Borrow"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>