<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">


    <!-- ================= HEADER ================= -->

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#6C4AB6"
        android:title="My Activity"
        android:titleTextColor="@android:color/white"
        app:navigationIconTint="@android:color/white" />

    <!-- ================= CONTENT ================= -->

    <ScrollView
        android:id="@+id/activityScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/activityMainLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#FFFFFF">

            <!-- TITLE -->

            <TextView
                android:id="@+id/activityTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your Activity"
                android:textSize="21sp"
                android:textStyle="bold"
                android:textColor="#222222"
                android:layout_marginBottom="15dp"/>


            <!-- ================= TOTAL RENTALS ================= -->

            <LinearLayout
                android:id="@+id/totalRentalsCard"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#F5F0FF"
                android:layout_marginBottom="12dp"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Rentals"
                    android:textSize="16sp"
                    android:textColor="#555555"/>

                <TextView
                    android:id="@+id/totalRentalsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#6A1B9A"/>

            </LinearLayout>


            <!-- ================= MY BOOKINGS ================= -->

            <LinearLayout
                android:id="@+id/myBookingsCard"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#F5F0FF"
                android:layout_marginBottom="12dp"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="My Bookings"
                    android:textSize="16sp"
                    android:textColor="#555555"/>

                <TextView
                    android:id="@+id/myBookingsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#6A1B9A"/>

            </LinearLayout>


            <!-- ================= ITEMS LISTED ================= -->

            <LinearLayout
                android:id="@+id/itemsListedCard"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#F5F0FF"
                android:layout_marginBottom="12dp"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Items Listed"
                    android:textSize="16sp"
                    android:textColor="#555555"/>

                <TextView
                    android:id="@+id/itemsListedText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="7"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#6A1B9A"/>

            </LinearLayout>


            <!-- ================= COMPLETED RENTALS ================= -->

            <LinearLayout
                android:id="@+id/completedCard"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#F5F0FF"
                android:layout_marginBottom="12dp"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Completed Rentals"
                    android:textSize="16sp"
                    android:textColor="#555555"/>

                <TextView
                    android:id="@+id/completedText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="8"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#6A1B9A"/>

            </LinearLayout>


            <!-- ================= CANCELLED BOOKINGS ================= -->

            <LinearLayout
                android:id="@+id/cancelledCard"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#F5F0FF"
                android:layout_marginBottom="12dp"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cancelled Bookings"
                    android:textSize="16sp"
                    android:textColor="#555555"/>

                <TextView
                    android:id="@+id/cancelledText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#6A1B9A"/>

            </LinearLayout>


            <!-- ================= TRUST SCORE ================= -->

            <LinearLayout
                android:id="@+id/trustScoreCard"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#F5F0FF"
                android:layout_marginBottom="12dp"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Trust Score"
                    android:textSize="16sp"
                    android:textColor="#555555"/>

                <TextView
                    android:id="@+id/trustScoreText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⭐ 4.8"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#6A1B9A"/>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>