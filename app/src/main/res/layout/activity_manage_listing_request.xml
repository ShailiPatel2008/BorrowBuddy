<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F6F3F8">

    <!-- TOOLBAR -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#AB47BC">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="55dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="←"
            android:textColor="#FFFFFF"
            android:textSize="38sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Manage Listing Request"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:textStyle="bold"/>

        <View
            android:layout_width="55dp"
            android:layout_height="1dp"/>

    </LinearLayout>


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- HEADER -->

            <TextView
                android:id="@+id/txtHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Review and manage item listing requests"
                android:textColor="#000000"
                android:textSize="17sp"
                android:textStyle="bold"/>


            <!-- PENDING -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:elevation="4dp">

                <TextView
                    android:id="@+id/txtPendingCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3"
                    android:textColor="#7E57C2"
                    android:textSize="42sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pending Listing Requests"
                    android:textColor="#000000"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

            </LinearLayout>


            <!-- REQUEST 1 -->

            <LinearLayout
                android:id="@+id/requestCard1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="#FFFFFF"
                android:elevation="4dp">

                <TextView
                    android:id="@+id/txtItemName1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📷  Canon Camera"
                    android:textColor="#000000"
                    android:textSize="24sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/txtOwner1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="👤  Owner: Rahul Patel"
                    android:textColor="#000000"
                    android:textSize="17sp"/>

                <TextView
                    android:id="@+id/txtCategory1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="🏷  Category: Camera"
                    android:textColor="#000000"
                    android:textSize="17sp"/>

                <TextView
                    android:id="@+id/txtPrice1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="💰  ₹300 / day"
                    android:textColor="#000000"
                    android:textSize="17sp"/>

                <TextView
                    android:id="@+id/txtStatus1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="● Pending Approval"
                    android:textColor="#D99A00"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

                <Button
                    android:id="@+id/btnViewDetails1"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="15dp"
                    android:text="VIEW DETAILS"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:backgroundTint="#808080"/>

                <Button
                    android:id="@+id/btnApprove1"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:text="✓  APPROVE REQUEST"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:backgroundTint="#808080"/>

                <Button
                    android:id="@+id/btnReject1"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:text="✕  REJECT REQUEST"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:backgroundTint="#808080"/>

            </LinearLayout>


            <!-- REQUEST 2 -->

            <LinearLayout
                android:id="@+id/requestCard2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="#FFFFFF"
                android:elevation="4dp">

                <TextView
                    android:id="@+id/txtItemName2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🔧  Drill Machine"
                    android:textColor="#000000"
                    android:textSize="24sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/txtOwner2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="👤  Owner: Priya Patel"
                    android:textColor="#000000"
                    android:textSize="17sp"/>

                <TextView
                    android:id="@+id/txtCategory2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="🏷  Category: Tools"
                    android:textColor="#000000"
                    android:textSize="17sp"/>

                <TextView
                    android:id="@+id/txtPrice2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="💰  ₹250 / day"
                    android:textColor="#000000"
                    android:textSize="17sp"/>

                <TextView
                    android:id="@+id/txtStatus2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="● Pending Approval"
                    android:textColor="#D99A00"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

                <Button
                    android:id="@+id/btnViewDetails2"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="15dp"
                    android:text="VIEW DETAILS"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:backgroundTint="#808080"/>

                <Button
                    android:id="@+id/btnApprove2"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:text="✓  APPROVE REQUEST"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:backgroundTint="#808080"/>

                <Button
                    android:id="@+id/btnReject2"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:text="✕  REJECT REQUEST"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:backgroundTint="#808080"/>

            </LinearLayout>


            <!-- REQUEST 3 -->

            <LinearLayout
                android:id="@+id/requestCard3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="#FFFFFF"
                android:elevation="4dp">

                <TextView
                    android:id="@+id/txtItemName3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📽  Projector"
                    android:textColor="#000000"
                    android:textSize="24sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/txtOwner3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="👤  Owner: Amit"
                    android:textColor="#000000"
                    android:textSize="17sp"/>

                <TextView
                    android:id="@+id/txtCategory3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="🏷  Category: Electronics"
                    android:textColor="#000000"
                    android:textSize="17sp"/>

                <TextView
                    android:id="@+id/txtPrice3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="💰  ₹400 / day"
                    android:textColor="#000000"
                    android:textSize="17sp"/>

                <TextView
                    android:id="@+id/txtStatus3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="● Pending Approval"
                    android:textColor="#D99A00"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

                <Button
                    android:id="@+id/btnViewDetails3"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="15dp"
                    android:text="VIEW DETAILS"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:backgroundTint="#808080"/>

                <Button
                    android:id="@+id/btnApprove3"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:text="✓  APPROVE REQUEST"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:backgroundTint="#808080"/>

                <Button
                    android:id="@+id/btnReject3"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:text="✕  REJECT REQUEST"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:backgroundTint="#808080"/>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>