<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F6F3F8">

    <!-- TOOLBAR -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#AB47BC">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:gravity="center"
            android:text="←"
            android:textColor="#FFFFFF"
            android:textSize="36sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/txtPageTitle"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="ITEM UPDATE REQUESTS"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:textStyle="bold"/>

        <View
            android:layout_width="55dp"
            android:layout_height="55dp"/>

    </LinearLayout>

    <!-- CONTENT -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="15dp">

            <TextView
                android:id="@+id/txtPendingRequests"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pending Requests: 2"
                android:textColor="#000000"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="15dp"/>

            <!-- CAMERA -->

            <LinearLayout
                android:id="@+id/requestCard1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="#FFFFFF"
                android:elevation="4dp"
                android:layout_marginBottom="15dp">

                <TextView
                    android:id="@+id/txtItemName1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📷 DSLR Camera"
                    android:textColor="#000000"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/txtOwner1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Owner: Amit Patel"
                    android:textColor="#000000"
                    android:textSize="17sp"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:id="@+id/txtChanges1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Changes: 4"
                    android:textColor="#000000"
                    android:textSize="17sp"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:id="@+id/txtDate1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Date: 02 Sep 2026"
                    android:textColor="#000000"
                    android:textSize="17sp"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:id="@+id/btnViewRequest1"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:gravity="center"
                    android:text="VIEW REQUEST"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:background="@drawable/grey_button"
                    android:clickable="true"
                    android:focusable="true"/>

            </LinearLayout>

            <!-- BICYCLE -->

            <LinearLayout
                android:id="@+id/requestCard2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="#FFFFFF"
                android:elevation="4dp"
                android:layout_marginBottom="15dp">

                <TextView
                    android:id="@+id/txtItemName2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🚲 Bicycle"
                    android:textColor="#000000"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/txtOwner2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Owner: Rahul"
                    android:textColor="#000000"
                    android:textSize="17sp"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:id="@+id/txtChanges2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Changes: 2"
                    android:textColor="#000000"
                    android:textSize="17sp"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:id="@+id/txtDate2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Date: 02 Sep 2026"
                    android:textColor="#000000"
                    android:textSize="17sp"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:id="@+id/btnViewRequest2"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:gravity="center"
                    android:text="VIEW REQUEST"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:background="@drawable/grey_button"
                    android:clickable="true"
                    android:focusable="true"/>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>